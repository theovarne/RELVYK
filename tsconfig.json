{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "allowJs": true,
    "checkJs": true, "noEmit": true, "skipLibCheck": true, "strict": false,
    "types": ["node"]
  },
  "include": ["src/**/*.js", "api/**/*.js", "app.js", "serve.mjs", "scripts/*.mjs"],
  "exclude": ["node_modules", "public", "tests", "figures"]
}
